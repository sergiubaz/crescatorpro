# Baza de date PostgreSQL
# Neon.tech: https://neon.tech → creezi un proiect → copiezi connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth secret - generează cu: openssl rand -base64 32
AUTH_SECRET="generează-un-secret-random-de-32-caractere"

# URL-ul aplicației tale
NEXTAUTH_URL="http://localhost:3000"
